# ------------------------------------------------------------------
# NxK Greetings — environment configuration
# Copy this file to `.env` and fill in values from:
# Firebase Console → Project settings → General → Your apps → Web app
# ------------------------------------------------------------------
# IMPORTANT (₹0 architecture):
# - Version 1 uses ONLY Firebase Authentication + Firestore (+ Hosting).
# - Firebase Storage is intentionally NOT used in v1. Even if your Firebase
#   config includes a storageBucket value, the app never imports or calls
#   Firebase Storage APIs. The variable below is accepted for future use only.
# - If these variables are missing, the app automatically starts in Demo Mode
#   (clearly labeled, data stays on-device, nothing pretends to be saved).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: canonical public origin used for share links / SEO tags.
# Defaults to window.location.origin when unset.
# VITE_APP_URL=https://your-app.web.app
